# Environment for the containerised production stack (compose.prod.yaml).
# Copy to .env.docker and fill in APP_KEY.
#
# Generate a key with:
#   docker run --rm barkeep:latest php artisan key:generate --show
# ...or reuse the one from your existing .env.

APP_NAME=Barkeep
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite lives inside the `storage` volume so it survives image rebuilds.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite

OCTANE_SERVER=swoole
OCTANE_HTTPS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set this when running behind a load balancer or reverse proxy.
# TRUSTED_PROXIES=*
