# Environment for the containerised production stack (compose.prod.yaml).
# Copy to .env.docker, fill in APP_KEY, and pass it to compose:
#   docker compose --env-file .docker/.env.docker \
#     -f .docker/compose.prod.yaml up
#
# On a managed host (Dockhand et al.) this file is not used at all --
# put these values in the stack's own environment instead.
#
# Generate a key with:
#   docker run --rm ghcr.io/nothehi/barkeep:latest php artisan key:generate --show
# ...or reuse the one from your existing .env.

# Which published image the stack runs. APP_TAG is `latest` (tracks main), a
# semver tag (`1.4.0`), or `sha-<commit>` to pin an exact build for a rollback.
# APP_PULL_POLICY=missing keeps compose from reaching for the registry when you
# are running an image you built locally.
APP_IMAGE=ghcr.io/nothehi/barkeep
APP_TAG=latest
# APP_PULL_POLICY=always

APP_NAME=Barkeep
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://barkeep.ir

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite lives inside the `storage` volume so it survives image rebuilds.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite

OCTANE_SERVER=swoole
# Off deliberately. This setting forces https onto every generated URL
# regardless of the request, which breaks any plain-HTTP way in — the port the
# stack publishes included: assets addressed https:// on an http:// origin do
# not load at all, and the page arrives blank. bootstrap/app.php trusts
# Traefik's X-Forwarded-Proto instead, so a request that did arrive over TLS
# still gets https:// URLs.
OCTANE_HTTPS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Nothing to set: bootstrap/app.php trusts any proxy on a private subnet, which
# is the docker network Traefik reaches this container over. That is what gives
# both the scheme above and a real request()->ip() for rate limiting and logs.
# A proxy somewhere off those subnets has to be named there instead — not here,
# and not as `*`, which would trust the published port too.
